+    JNIEnv* env, jobject obj, jstring jkey, jint value) {
+    const auto key = Common::Android::GetJString(env, jkey);
+
+    if (key == "accelerate_astc") {
+        if (value < 0 || value > 2) {
+            LOG_ERROR(Frontend, "[Android Native] Invalid ASTC decode mode: {}", value);
+            return;
+        }
+
+        auto setting = getSetting<Settings::AstcDecodeMode>(env, jkey);
