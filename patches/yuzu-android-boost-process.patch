 #include "common/logging/log.h"
 #include "common/polyfill_thread.h"
@@ -19,6 +26,74 @@
 #include "core/hle/kernel/k_process.h"
 #include "core/hle/kernel/k_scheduler.h"

+#ifdef __ANDROID__
+class DebuggerSignalPipe {
+public:
+    explicit DebuggerSignalPipe(boost::asio::io_context& context)
+        : read_end(context), write_end(context) {
+        int descriptors[2] = {-1, -1};
+
+        if (::pipe(descriptors) != 0) {
+            throw std::system_error(
+                errno, std::generic_category(), "Debugger signal pipe");
+        }
+
+        boost::system::error_code error;
+        read_end.assign(descriptors[0], error);
+
+        if (error) {
+            ::close(descriptors[0]);
+            ::close(descriptors[1]);
+            throw std::system_error(
+                error.value(), std::system_category(),
+                "Assign debugger pipe read end");
+        }
+
+        write_end.assign(descriptors[1], error);
+
+        if (error) {
+            boost::system::error_code ignored;
+            read_end.close(ignored);
+            ::close(descriptors[1]);
+            throw std::system_error(
+                error.value(), std::system_category(),
+                "Assign debugger pipe write end");
+        }
+    }
+
+    template <typename BufferSequence, typename Handler>
+    void async_read_some(const BufferSequence& buffers, Handler&& handler) {
+        read_end.async_read_some(
+            buffers, std::forward<Handler>(handler));
+    }
+
+    template <typename BufferSequence>
+    std::size_t write_some(
+        const BufferSequence& buffers,
+        boost::system::error_code& error) {
+        return write_end.write_some(buffers, error);
+    }
+
+    template <typename BufferSequence>
+    std::size_t write_some(const BufferSequence& buffers) {
+        return write_end.write_some(buffers);
+    }
+
+    void close() {
+        boost::system::error_code ignored;
+        read_end.close(ignored);
+        write_end.close(ignored);
+    }
+
+private:
+    boost::asio::posix::stream_descriptor read_end;
+    boost::asio::posix::stream_descriptor write_end;
+};
+#else
+using DebuggerSignalPipe = boost::process::v1::async_pipe;
+#endif
+
+
 template <typename Readable, typename Buffer, typename Callback>
 static void AsyncReceiveInto(Readable& r, Buffer& buffer, Callback&& c) {
     static_assert(std::is_trivial_v<Buffer>);
@@ -326,7 +401,7 @@ private:

